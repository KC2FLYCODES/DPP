rules_version = '2';
// DPP Studio — only accounts listed in members/{email} can read or write anything.
// Add a teammate: Firestore console → members → document ID = their sign-in email (lowercase), field name = "Kendrick".
service cloud.firestore {
  match /databases/{database}/documents {
    function email() { return request.auth.token.email.lower(); }
    function member() {
      return request.auth != null && request.auth.token.email != null
        && exists(/databases/$(database)/documents/members/$(email()));
    }

    // Allowlist. Read your own entry (sign-in check) or all of them once you're in. Edit only in the console.
    match /members/{e} {
      allow read: if request.auth != null && (e == email() || member());
      allow write: if false;
    }

    match /designs/{id} { allow read, write: if member(); }
    match /media/{id} { allow read, write: if member(); match /c/{part} { allow read, write: if member(); } }
    match /assets/{id} { allow read, write: if member(); match /c/{part} { allow read, write: if member(); } }
    match /comments/{id} { allow read, write: if member(); }
    match /suppliers/{id} { allow read, write: if member(); }

    // Supplier packets (Send to supplier). The token in the link is the only key: anyone holding it can READ that one
    // packet while it is live (not revoked, not expired) and add one view. Nobody outside the team can list packets,
    // write them, or touch any other field. Members create, revoke and delete.
    match /shares/{t} {
      function head() { return get(/databases/$(database)/documents/shares/$(t)).data; }
      function live() { return head().revoked != true && head().exp > request.time; }
      allow get: if member() || (resource.data.revoked != true && resource.data.exp > request.time);
      allow list: if member();
      allow create, delete: if member();
      allow update: if member()
        || (resource.data.revoked != true && resource.data.exp > request.time
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views', 'seen'])
            && request.resource.data.views == resource.data.views + 1);
      match /b/{k} {
        allow get: if member() || live();
        allow list, write: if member();
        match /c/{p} { allow get: if member() || live(); allow list, write: if member(); }
      }
    }

    // Presence: everyone can see who's around; you can only write your own heartbeat.
    match /presence/{uid} {
      allow read: if member();
      allow write: if member() && request.auth.uid == uid;
    }
  }
}
